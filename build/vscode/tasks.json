{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build C (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "mkdir -p build && gcc -g -O0 -Wall -Wextra -std=c11 *.c -o build/app"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Compila todos os .c em build/app"
    },
    {
      "label": "build arquivo atual (Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "mkdir -p build && gcc -g -O0 -Wall -Wextra -std=c11 \"${file}\" -o \"build/${fileBasenameNoExtension}\""
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
